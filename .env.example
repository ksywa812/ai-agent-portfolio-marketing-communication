# required
ANTHROPIC_API_KEY=your-api-key-here

# optional — model to use (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# optional — max tool calls per agent run (default: 10)
AGENT_MAX_ITERATIONS=10

# optional — logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# optional — write logs to file alongside stdout
LOG_FILE=

# optional — persist mock state to disk between runs (default: false)
MOCK_PERSIST_STATE=false
